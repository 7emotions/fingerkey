[Unit]
Description=FingerKey approval daemon
Wants=network-online.target
After=network-online.target

[Service]
User=phonefprint
RuntimeDirectory=phone-fprint-auth
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/fingerkeyd -socket /run/phone-fprint-auth/daemon.sock -keys-dir /var/lib/phone-fprint-auth/keys -addr :4443 -tls-dir /var/lib/phone-fprint-auth/tls -max-conns 16 -max-conns-per-ip 4
Restart=on-failure

[Install]
WantedBy=multi-user.target
