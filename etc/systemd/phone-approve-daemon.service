[Unit]
Description=Phone fingerprint approval daemon
After=network.target bluetooth.service
Wants=bluetooth.service

[Service]
User=phonefprint
RuntimeDirectory=phone-fprint-auth
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/phone-approve-daemon -socket /run/phone-fprint-auth/daemon.sock -keys-dir /var/lib/phone-fprint-auth/keys -adapter hci0
Restart=on-failure

[Install]
WantedBy=multi-user.target
