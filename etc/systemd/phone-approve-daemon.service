[Unit]
Description=Phone fingerprint approval daemon
After=network.target

[Service]
User=phonefprint
RuntimeDirectory=phone-fprint-auth
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/phone-approve-daemon -addr :8766 -socket /run/phone-fprint-auth/daemon.sock
Restart=on-failure

[Install]
WantedBy=multi-user.target
